{
  "schema_version": "1.0",
  "method_config": {
    "id": "pnu_4f_corridor_raw_sionna_plain_idw_residual_idw_v1",
    "status": "ready",
    "sionna": {
      "input_metric": "path_gain_linear",
      "prediction_unit": "dBm",
      "conversion": "tx_power_dbm + 10*log10(path_gain_linear)"
    },
    "idw": {
      "power": 2.0,
      "distance_space": "xyz_meters",
      "epsilon_distance_power": 1e-12,
      "exact_match_tolerance_m": 1e-9,
      "power_selection": {
        "default": "fixed",
        "fixed_value": 2.0,
        "fallback_if_needed": "calibration_leave_one_out_only",
        "fallback_candidates": [1.0, 2.0, 3.0]
      }
    },
    "data_split_policy": {
      "fit_role": "calibration",
      "evaluation_role": "test",
      "exclude_test_from_fitting": true
    },
    "evaluation": {
      "target_column": "corrected_rssi",
      "metrics": ["mae", "rmse"]
    },
    "heatmap": {
      "shared_color_scale": true,
      "color_scale_mode": "shared_min_max_across_three_methods",
      "coordinate_plane": "xy",
      "value_unit": "dBm"
    }
  }
}
