{
  "schema_version": "1.0",
  "sionna_rssi": {
    "id": "classroom_path_and_radio_map_v1",
    "status": "provisional",
    "scene_source": {
      "default_mode": "metric_proxy_export",
      "prebuilt_scene_xml_usage": "optional_cli_override_after_obstacle_scene_build"
    },
    "runtime": {
      "required_sionna_rt_version": "1.2.2",
      "required_mitsuba_version": "3.8.0",
      "required_drjit_version": "1.3.1"
    },
    "materials": {
      "floor": {"preset": "concrete"},
      "ceiling": {"preset": "concrete"},
      "walls": {"preset": "concrete"}
    },
    "antenna": {
      "pattern": "iso",
      "polarization": "V"
    },
    "path_solver": {
      "max_depth": 2,
      "samples_per_src": 100000,
      "seed": 42,
      "synthetic_array": true,
      "enable_los": true,
      "enable_reflection": true,
      "enable_refraction": false,
      "enable_diffraction": false,
      "enable_scattering": false
    },
    "radio_map": {
      "z_height_m": 1.2,
      "margin_m": 0.25,
      "cell_size_m": 0.5,
      "max_cells": 2000,
      "samples_per_tx": 100000,
      "seed": 43,
      "max_depth": 2,
      "enable_los": true,
      "enable_reflection": true,
      "enable_refraction": false,
      "enable_diffraction": false,
      "enable_scattering": false
    },
    "validation": {
      "device_clearance_m": 0.05,
      "minimum_valid_grid_ratio": 0.05,
      "minimum_valid_grid_points": 3,
      "rss_consistency_tolerance_db": 0.0001
    }
  }
}
