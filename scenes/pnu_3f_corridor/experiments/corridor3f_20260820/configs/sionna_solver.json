{
  "schema_version": "1.0",
  "sionna_rssi": {
    "id": "corridor3f_diffraction_scattering_d5_v1",
    "status": "provisional",
    "scene_source": {
      "default_mode": "metric_proxy_export",
      "prebuilt_scene_xml_usage": "optional_cli_override_after_obstacle_scene_build"
    },
    "runtime": {
      "required_sionna_rt_version": "1.2.2",
      "required_mitsuba_version": "3.8.0",
      "required_drjit_version": "1.3.1"
    },
    "materials": {
      "floor": {
        "preset": "concrete",
        "scattering_coefficient": 0.3
      },
      "ceiling": {
        "preset": "concrete",
        "scattering_coefficient": 0.3
      },
      "walls": {
        "preset": "concrete",
        "scattering_coefficient": 0.3
      }
    },
    "antenna": {
      "pattern": "iso",
      "polarization": "V"
    },
    "path_solver": {
      "max_depth": 5,
      "samples_per_src": 8000000,
      "seed": 42,
      "synthetic_array": true,
      "enable_los": true,
      "enable_reflection": true,
      "enable_refraction": false,
      "enable_diffraction": true,
      "enable_scattering": true,
      "max_num_paths_per_src": 40000000
    },
    "radio_map": {
      "z_height_m": 0.45,
      "margin_m": 0.25,
      "cell_size_m": 0.75,
      "max_cells": 4000,
      "samples_per_tx": 512000000,
      "seed": 43,
      "max_depth": 5,
      "enable_los": true,
      "enable_reflection": true,
      "enable_refraction": false,
      "enable_diffraction": true,
      "enable_scattering": true
    },
    "validation": {
      "device_clearance_m": 0.05,
      "minimum_valid_grid_ratio": 0.05,
      "minimum_valid_grid_points": 3,
      "rss_consistency_tolerance_db": 0.0001
    },
    "notes_ko": [
      "회절과 확산 반사를 기본으로 켠다. 코어 뒤 NLOS 지점은 정반사만으로는 경로가 0개다.",
      "scattering_coefficient 0.3은 거친 콘크리트 문헌값 범위의 중간값이며 실측이 아니다. 0이면 enable_scattering이 무의미하다.",
      "max_num_paths_per_src는 samples_per_src와 함께 올려야 한다. 후보 경로가 한도를 넘으면 약한 RX의 경로가 통째로 잘려 유효 경로 0개가 된다.",
      "샘플 수렴 확인(2026-08-20): LOS 지점은 0.1 dB 이내, 코어 뒤 깊은 그림자 지점은 8M 샘플에서도 약 3.5 dB 흔들린다.",
      "radio_map samples_per_tx 512M에서 실내 셀 837개 중 791개에 값이 생긴다(8M이면 670개). GPU에서 0.85초다.",
      "128M과 512M 사이의 셀 값 차이는 중앙값 0.03 dB지만 상위 5%는 16 dB다. 밝은 영역은 수렴했고 깊은 그림자 셀은 아직 아니다."
    ]
  }
}
